 #include "../runtime/diag/kl_metadump.h"
@@ -695,6 +696,26 @@ static void *view_guest_thread(void *arg) {
     return NULL;
 }
 
+// KL_MVR=1: the MoltenVR frontend (kl_mvr.m). view_run's shape, with MoltenVR's OpenXR runtime
+// as the display: the guest on a spawned thread, the runtime's frame loop on this one.
+static int mvr_run(void) {
+    if (!kl_mvr_init()) return 1;
+    // GL guests get MTLTexture-backed eyes from the provider; a Vulkan guest's come from
+    // MoltenVK on their own
+    if (kl_env_on("KL_GLFB", 0) && kl_glfb_mtl_device()) kl_mtl_provider_install();
+    int owns_loop = (TARGET->kind == KL_GUEST_STEAMLINK && DOOR == KL_SLINK_VR) ||
+                    TARGET->kind == KL_GUEST_JKXR;
+    if (owns_loop && kl_env_on("KL_XR_PACE", 1)) kl_openxr_set_frame_pacer(kl_mvr_pace_wait);
+    pthread_t guest;
+    if (pthread_create(&guest, NULL, view_guest_thread, NULL)) return 1;
+    int rc = kl_mvr_main(&g_view_quit);
+    g_view_quit = 1;
+    if (TARGET->kind == KL_GUEST_STEAMLINK) pthread_detach(guest);
+    else                                    pthread_join(guest, NULL);
+    kl_driver_report(stdout);
+    return rc;
+}
+
 // KL_VIEW=1: the interactive frontend (kl_view.c). This deliberately skips
 // BOTH process games main() normally plays:
 //  - the DRM-guard fork test, because the guard itself lives in kl_ovrplat.c
@@ -877,6 +898,8 @@ int main(int argc, char **argv) {
     if (getenv("KL_RECON_CHILD"))
         return recon_run(0);
 
+    if (getenv("KL_MVR"))
+        return mvr_run();
     if (getenv("KL_VIEW"))
         return view_run();
 
diff --git a/runtime/gfx/kl_mvr.h b/runtime/gfx/kl_mvr.h
new file mode 100644
index 0000000..85976b7
--- /dev/null
+++ b/runtime/gfx/kl_mvr.h
@@ -0,0 +1,18 @@
+// KL_MVR=1: the MoltenVR frontend (kl_mvr.m). The guest's frames go to MoltenVR's macOS
+// OpenXR runtime, which streams them to the headset; the headset's poses come back the same way.
+#ifndef KL_MVR_H
+#define KL_MVR_H
+
+// Before the guest thread exists: load the runtime, open the session, and tell kl_ovrp the
+// display rate and eye size the guest will read once at boot. 0 on failure.
+int kl_mvr_init(void);
+
+// The OpenXR frame loop, on the calling thread, until the session ends, *quit is set, or
+// KL_FRAMES display frames have gone by.
+int kl_mvr_main(volatile int *quit);
+
+// For guests that own their frame loop (kl_openxr_set_frame_pacer): returns once per frame
+// the runtime starts, or after a timeout so a stalled runtime never wedges the guest.
+void kl_mvr_pace_wait(void);
+
+#endif
diff --git a/runtime/gfx/kl_mvr.m b/runtime/gfx/kl_mvr.m
new file mode 100644
index 0000000..e34fe2d
--- /dev/null
+++ b/runtime/gfx/kl_mvr.m
@@ -0,0 +1,563 @@
+// KL_MVR=1: the MoltenVR frontend.
+//
+// An ordinary OpenXR app on MoltenVR's macOS runtime (XR_KHR_metal_enable). Each display frame
+// it hands the runtime's head and eye poses to kl_ovrp, takes the guest's newest finished frame
+// out of kl_glfb (eye MTLTextures, whichever API drew them), draws both eyes into the runtime's
+// swapchain and submits them at the pose the guest rendered with, so MoltenVR's own reprojection
+// corrects for the head moving since.
+#import <Metal/Metal.h>
+#pragma clang diagnostic ignored "-Wmissing-field-initializers"   // OpenXR structs start {XR_TYPE_...}
+#define XR_USE_GRAPHICS_API_METAL
+#include <openxr/openxr.h>
+#include <openxr/openxr_platform.h>
+#include <openxr/openxr_loader_negotiation.h>
+#include <dispatch/dispatch.h>
+#include <dlfcn.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "kl_glfb.h"
+#include "kl_mvr.h"
+#include "kl_ovrp.h"
+#include "kl_vulkan.h"
+
+static PFN_xrGetInstanceProcAddr gpa;
+static XrInstance g_inst;
+static XrSystemId g_sys;
+static XrSession g_sess;
+static XrSwapchain g_swap;
+static XrSpace g_local, g_view;
+static uint32_t g_w, g_h;
+static int64_t g_fmt;
+static id<MTLDevice> g_dev;
+static id<MTLCommandQueue> g_queue;
+static id<MTLRenderPipelineState> g_pipe;
+static id<MTLSharedEvent> g_event;
+static NSMutableArray<id<MTLTexture>> *g_images;
+static dispatch_semaphore_t g_pace;
+
+#define XRFN(name) static PFN_##name p_##name
+XRFN(xrPollEvent); XRFN(xrBeginSession); XRFN(xrEndSession); XRFN(xrWaitFrame); XRFN(xrBeginFrame);
+XRFN(xrEndFrame); XRFN(xrLocateViews); XRFN(xrLocateSpace); XRFN(xrAcquireSwapchainImage);
+XRFN(xrWaitSwapchainImage); XRFN(xrReleaseSwapchainImage);
+
+static void *xrfn(const char *name) {
+    PFN_xrVoidFunction f = NULL;
+    gpa(g_inst, name, &f);
+    if (!f) fprintf(stderr, "  [mvr] runtime has no %s\n", name);
+    return (void *)f;
+}
+
+#define CHECK(x) do { XrResult r_ = (x); if (XR_FAILED(r_)) { \
+    fprintf(stderr, "  [mvr] %s -> %d\n", #x, (int)r_); return 0; } } while (0)
+
+typedef struct { float x, y, z, w; } quat;
+static quat qmul(quat a, quat b) {
+    return (quat){a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
+                  a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
+                  a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
+                  a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z};
+}
+static quat qconj(quat q) { return (quat){-q.x, -q.y, -q.z, q.w}; }
+static XrVector3f qrot(quat q, XrVector3f v) {
+    quat p = qmul(qmul(q, (quat){v.x, v.y, v.z, 0}), qconj(q));
+    return (XrVector3f){p.x, p.y, p.z};
+}
+static quat toq(XrQuaternionf q) { return (quat){q.x, q.y, q.z, q.w}; }
+
+// the current eye geometry, head-relative, kept for building the submitted views
+static XrVector3f g_eyeOff[2];
+static quat g_eyeRot[2] = {{0, 0, 0, 1}, {0, 0, 0, 1}};
+// KL_MVR_FLOOR: metres the runtime's origin sits below the guest's floor. MoltenVR's tracking
+// origin is already the headset's floor; this is for headless runs, where the head sits at 0.
+static float g_floor;
+static int g_input;
+static int initInput(void);
+static void publishControllers(XrTime t);
+
+static const char *kShader =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "struct V { float4 pos [[position]]; float2 uv; };\n"
+    "vertex V vs(uint vid [[vertex_id]], constant float4 &xf [[buffer(0)]]) {\n"
+    "    float2 p = float2((vid << 1) & 2, vid & 2);\n"
+    "    V o; o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+    "    o.uv = float2(p.x, 1.0 - p.y) * xf.xy + xf.zw;\n"
+    "    return o;\n"
+    "}\n"
+    "fragment float4 fs(V in [[stage_in]], texture2d_array<float> t [[texture(0)]],\n"
+    "                   constant uint &slice [[buffer(0)]]) {\n"
+    "    constexpr sampler s(filter::linear, address::clamp_to_edge);\n"
+    "    return float4(t.sample(s, in.uv, slice).rgb, 1.0);\n"
+    "}\n";
+
+static const char *runtimePath(void) {
+    const char *e = getenv("MOLTENVR_OPENXR_LIB");
+    if (e && *e) return e;
+    static char p[1024];
+    snprintf(p, sizeof p, "%s/Library/Application Support/MoltenVR/bin/libmoltenvr_openxr.dylib",
+             getenv("HOME") ?: "");
+    return p;
+}
+
+int kl_mvr_init(void) {
+    const char *path = runtimePath();
+    void *dl = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!dl) { fprintf(stderr, "  [mvr] %s\n", dlerror()); return 0; }
+    PFN_xrNegotiateLoaderRuntimeInterface negotiate =
+        (PFN_xrNegotiateLoaderRuntimeInterface)dlsym(dl, "xrNegotiateLoaderRuntimeInterface");
+    XrNegotiateLoaderInfo li = {XR_LOADER_INTERFACE_STRUCT_LOADER_INFO, XR_LOADER_INFO_STRUCT_VERSION,
+                                sizeof li, 1, XR_CURRENT_LOADER_RUNTIME_VERSION, XR_MAKE_VERSION(1, 0, 0),
+                                XR_CURRENT_API_VERSION};
+    XrNegotiateRuntimeRequest rr = {XR_LOADER_INTERFACE_STRUCT_RUNTIME_REQUEST,
+                                    XR_RUNTIME_INFO_STRUCT_VERSION, sizeof rr};
+    if (!negotiate || XR_FAILED(negotiate(&li, &rr))) { fprintf(stderr, "  [mvr] negotiate failed\n"); return 0; }
+    gpa = rr.getInstanceProcAddr;
+
+    const char *ext[] = {"XR_KHR_metal_enable"};
+    XrInstanceCreateInfo ici = {XR_TYPE_INSTANCE_CREATE_INFO};
+    strcpy(ici.applicationInfo.applicationName, "Klepton");
+    ici.applicationInfo.apiVersion = XR_MAKE_VERSION(1, 0, 0);
+    ici.enabledExtensionCount = 1;
+    ici.enabledExtensionNames = ext;
+    CHECK(((PFN_xrCreateInstance)xrfn("xrCreateInstance"))(&ici, &g_inst));
+    XrSystemGetInfo sgi = {XR_TYPE_SYSTEM_GET_INFO};
+    sgi.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+    CHECK(((PFN_xrGetSystem)xrfn("xrGetSystem"))(g_inst, &sgi, &g_sys));
+
+    XrGraphicsRequirementsMetalKHR req = {XR_TYPE_GRAPHICS_REQUIREMENTS_METAL_KHR};
+    CHECK(((PFN_xrGetMetalGraphicsRequirementsKHR)xrfn("xrGetMetalGraphicsRequirementsKHR"))(g_inst, g_sys, &req));
+    g_dev = (__bridge id<MTLDevice>)req.metalDevice;
+    g_queue = [g_dev newCommandQueue];
+    g_event = [g_dev newSharedEvent];
+
+    uint32_t nv = 0;
+    XrViewConfigurationView vcv[2] = {{XR_TYPE_VIEW_CONFIGURATION_VIEW}, {XR_TYPE_VIEW_CONFIGURATION_VIEW}};
+    CHECK(((PFN_xrEnumerateViewConfigurationViews)xrfn("xrEnumerateViewConfigurationViews"))(
+        g_inst, g_sys, XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, 2, &nv, vcv));
+    g_w = vcv[0].recommendedImageRectWidth;
+    g_h = vcv[0].recommendedImageRectHeight;
+
+    XrGraphicsBindingMetalKHR gb = {XR_TYPE_GRAPHICS_BINDING_METAL_KHR};
+    gb.commandQueue = (__bridge void *)g_queue;
+    XrSessionCreateInfo sci = {XR_TYPE_SESSION_CREATE_INFO};
+    sci.next = &gb;
+    sci.systemId = g_sys;
+    CHECK(((PFN_xrCreateSession)xrfn("xrCreateSession"))(g_inst, &sci, &g_sess));
+
+    PFN_xrEnumerateSwapchainFormats enumFmts = (PFN_xrEnumerateSwapchainFormats)xrfn("xrEnumerateSwapchainFormats");
+    uint32_t nf = 0;
+    enumFmts(g_sess, 0, &nf, NULL);
+    int64_t fmts[32];
+    if (nf > 32) nf = 32;
+    enumFmts(g_sess, nf, &nf, fmts);
+    g_fmt = nf ? fmts[0] : MTLPixelFormatBGRA8Unorm_sRGB;
+    for (uint32_t i = 0; i < nf; i++) if (fmts[i] == MTLPixelFormatBGRA8Unorm_sRGB) g_fmt = fmts[i];
+
+    XrSwapchainCreateInfo sc = {XR_TYPE_SWAPCHAIN_CREATE_INFO};
+    sc.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT;
+    sc.format = g_fmt;
+    sc.sampleCount = 1;
+    sc.width = g_w;
+    sc.height = g_h;
+    sc.faceCount = 1;
+    sc.arraySize = 2;
+    sc.mipCount = 1;
+    CHECK(((PFN_xrCreateSwapchain)xrfn("xrCreateSwapchain"))(g_sess, &sc, &g_swap));
+    PFN_xrEnumerateSwapchainImages enumImgs = (PFN_xrEnumerateSwapchainImages)xrfn("xrEnumerateSwapchainImages");
+    uint32_t ni = 0;
+    enumImgs(g_swap, 0, &ni, NULL);
+    XrSwapchainImageMetalKHR imgs[8];
+    if (ni > 8) ni = 8;
+    for (uint32_t i = 0; i < ni; i++) imgs[i] = (XrSwapchainImageMetalKHR){XR_TYPE_SWAPCHAIN_IMAGE_METAL_KHR};
+    CHECK(enumImgs(g_swap, ni, &ni, (XrSwapchainImageBaseHeader *)imgs));
+    g_images = [NSMutableArray array];
+    for (uint32_t i = 0; i < ni; i++) [g_images addObject:(__bridge id<MTLTexture>)imgs[i].texture];
+
+    XrReferenceSpaceCreateInfo rs = {XR_TYPE_REFERENCE_SPACE_CREATE_INFO};
+    rs.poseInReferenceSpace.orientation.w = 1;
+    rs.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
+    CHECK(((PFN_xrCreateReferenceSpace)xrfn("xrCreateReferenceSpace"))(g_sess, &rs, &g_local));
+    rs.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_VIEW;
+    CHECK(((PFN_xrCreateReferenceSpace)xrfn("xrCreateReferenceSpace"))(g_sess, &rs, &g_view));
+
+    p_xrPollEvent = xrfn("xrPollEvent"); p_xrBeginSession = xrfn("xrBeginSession");
+    p_xrEndSession = xrfn("xrEndSession"); p_xrWaitFrame = xrfn("xrWaitFrame");
+    p_xrBeginFrame = xrfn("xrBeginFrame"); p_xrEndFrame = xrfn("xrEndFrame");
+    p_xrLocateViews = xrfn("xrLocateViews"); p_xrLocateSpace = xrfn("xrLocateSpace");
+    p_xrAcquireSwapchainImage = xrfn("xrAcquireSwapchainImage");
+    p_xrWaitSwapchainImage = xrfn("xrWaitSwapchainImage");
+    p_xrReleaseSwapchainImage = xrfn("xrReleaseSwapchainImage");
+
+    g_input = initInput();
+    if (!g_input) fprintf(stderr, "  [mvr] no controller input\n");
+
+    NSError *err = nil;
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:@(kShader) options:nil error:&err];
+    if (!lib) { fprintf(stderr, "  [mvr] shader: %s\n", err.localizedDescription.UTF8String); return 0; }
+    MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+    pd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+    pd.colorAttachments[0].pixelFormat = (MTLPixelFormat)g_fmt;
+    g_pipe = [g_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+    if (!g_pipe) { fprintf(stderr, "  [mvr] pipeline: %s\n", err.localizedDescription.UTF8String); return 0; }
+
+    // read once by the guest at boot, so these go in now
+    const char *fps = getenv("VB_FPS");
+    kl_ovrp_set_display_frequency(fps && atof(fps) > 0 ? (float)atof(fps) : 72.0f);
+    kl_ovrp_set_eye_texture_size((int)g_w, (int)g_h);
+    kl_glfb_set_gpu_fence((__bridge void *)g_event);
+    g_pace = dispatch_semaphore_create(0);
+    g_floor = getenv("KL_MVR_FLOOR") ? (float)atof(getenv("KL_MVR_FLOOR")) : 0.0f;
+    fprintf(stderr, "  [mvr] MoltenVR runtime %s: %ux%u per eye, format %lld, %u images, guest told %.0f Hz\n",
+            path, g_w, g_h, (long long)g_fmt, ni, (double)kl_ovrp_display_frequency());
+    return 1;
+}
+
+void kl_mvr_pace_wait(void) {
+    if (g_pace) dispatch_semaphore_wait(g_pace, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC));
+}
+
+// head and eyes from the runtime into kl_ovrp, for the frame the runtime just started
+static void publishPoses(XrTime t) {
+    XrSpaceLocation head = {XR_TYPE_SPACE_LOCATION};
+    if (XR_FAILED(p_xrLocateSpace(g_view, g_local, t, &head)) ||
+        !(head.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT)) return;
+    XrViewLocateInfo vli = {XR_TYPE_VIEW_LOCATE_INFO};
+    vli.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+    vli.displayTime = t;
+    vli.space = g_view;
+    XrViewState vs = {XR_TYPE_VIEW_STATE};
+    XrView views[2] = {{XR_TYPE_VIEW}, {XR_TYPE_VIEW}};
+    uint32_t n = 0;
+    if (XR_SUCCEEDED(p_xrLocateViews(g_sess, &vli, &vs, 2, &n, views)) && n == 2) {
+        for (int e = 0; e < 2; e++) {
+            XrFovf f = views[e].fov;
+            g_eyeOff[e] = views[e].pose.position;
+            g_eyeRot[e] = toq(views[e].pose.orientation);
+            kl_ovrp_set_eye_offset(e, g_eyeOff[e].x, g_eyeOff[e].y, g_eyeOff[e].z);
+            kl_ovrp_set_eye_rotation(e, g_eyeRot[e].x, g_eyeRot[e].y, g_eyeRot[e].z, g_eyeRot[e].w);
+            kl_ovrp_set_eye_frustum(e, tanf(-f.angleLeft), tanf(f.angleRight), tanf(f.angleUp), tanf(-f.angleDown));
+            static int said[2];
+            if (!said[e]++) fprintf(stderr, "  [mvr] eye %d: fov L%.1f R%.1f U%.1f D%.1f deg, offset %.4f %.4f %.4f, rot %.3f %.3f %.3f %.3f\n", e,
+                f.angleLeft * 57.2958f, f.angleRight * 57.2958f, f.angleUp * 57.2958f, f.angleDown * 57.2958f,
+                g_eyeOff[e].x, g_eyeOff[e].y, g_eyeOff[e].z, g_eyeRot[e].x, g_eyeRot[e].y, g_eyeRot[e].z, g_eyeRot[e].w);
+        }
+    }
+    XrPosef p = head.pose;
+    kl_ovrp_set_head_pose_time((double)t * 1e-9);
+    kl_ovrp_set_head_pose(p.position.x, p.position.y + g_floor, p.position.z,
+                          p.orientation.x, p.orientation.y, p.orientation.z, p.orientation.w);
+}
+
+static id<MTLTexture> arrayView(id<MTLTexture> t) {
+    static void *src[8];
+    static id<MTLTexture> views[8];
+    if (!t || t.textureType == MTLTextureType2DArray) return t;
+    for (int i = 0; i < 8; i++) if (src[i] == (__bridge void *)t) return views[i];
+    static int next;
+    int i = next++ % 8;
+    src[i] = (__bridge void *)t;
+    views[i] = [t newTextureViewWithPixelFormat:t.pixelFormat textureType:MTLTextureType2DArray
+                                         levels:NSMakeRange(0, t.mipmapLevelCount) slices:NSMakeRange(0, 1)];
+    return views[i];
+}
+
+// the guest's newest finished frame into the swapchain; 0 when there's nothing new to show
+static int drawGuestFrame(XrCompositionLayerProjectionView pv[2], uint64_t *lastValue) {
+    int stage = kl_ovrp_last_complete_stage();
+    if (stage < 0 || !kl_ovrp_eye_layer_live()) return 0;
+    uint64_t v = kl_glfb_gpu_fence_value();
+    int fenced = v != 0;
+    if (!v) v = kl_vulkan_frame_serial();
+    if (!v || v == *lastValue) return 0;
+
+    kl_ovrp_render_pose rp;
+    if (!kl_ovrp_stage_render_pose(stage, &rp)) return 0;
+    id<MTLTexture> src[2];
+    int slice[2];
+    for (int e = 0; e < 2; e++) {
+        src[e] = (__bridge id<MTLTexture>)kl_glfb_eye_mtl_texture(e, stage, &slice[e]);
+        if (!src[e]) return 0;
+        if (src[e].device != g_dev) {
+            static int said;
+            if (!said++) fprintf(stderr, "  [mvr] the guest's eyes are on another MTLDevice (%s), not the runtime's (%s)\n",
+                                 src[e].device.name.UTF8String, g_dev.name.UTF8String);
+            return 0;
+        }
+    }
+    *lastValue = v;
+    static int said;
+    if (!said++) fprintf(stderr, "  [mvr] guest rendered with tangents L(%.3f %.3f %.3f %.3f) R(%.3f %.3f %.3f %.3f), viewport %d %d of %d\n",
+        rp.tangents[0][0], rp.tangents[0][1], rp.tangents[0][2], rp.tangents[0][3],
+        rp.tangents[1][0], rp.tangents[1][1], rp.tangents[1][2], rp.tangents[1][3], rp.viewport[0][2], rp.viewport[0][3], rp.viewport_of[0]);
+
+    uint32_t idx = 0;
+    if (XR_FAILED(p_xrAcquireSwapchainImage(g_swap, NULL, &idx))) return 0;
+    XrSwapchainImageWaitInfo wi = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+    wi.timeout = XR_INFINITE_DURATION;
+    p_xrWaitSwapchainImage(g_swap, &wi);
+    id<MTLCommandBuffer> cb = [g_queue commandBuffer];
+    if (fenced) [cb encodeWaitForEvent:g_event value:v];
+    for (int e = 0; e < 2; e++) {
+        MTLRenderPassDescriptor *rd = [MTLRenderPassDescriptor renderPassDescriptor];
+        rd.colorAttachments[0].texture = g_images[idx];
+        rd.colorAttachments[0].slice = e;
+        rd.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+        rd.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:rd];
+        [enc setRenderPipelineState:g_pipe];
+        // the part of the eye texture the guest drew into, as a fraction, so a texture a
+        // generation newer than the record is still cropped right
+        float x = 0, y = 0, w = 1, h = 1;
+        if (rp.viewport[e][2] > 0 && rp.viewport_of[0] > 0 && rp.viewport_of[1] > 0) {
+            x = (float)rp.viewport[e][0] / rp.viewport_of[0];
+            y = (float)rp.viewport[e][1] / rp.viewport_of[1];
+            w = (float)rp.viewport[e][2] / rp.viewport_of[0];
+            h = (float)rp.viewport[e][3] / rp.viewport_of[1];
+        }
+        int top = kl_glfb_eye_mtl_origin_top_left(e, stage);
+        float xf[4] = {w, top ? h : -h, x, top ? y : y + h};
+        uint32_t sl = (uint32_t)slice[e];
+        [enc setVertexBytes:xf length:sizeof xf atIndex:0];
+        [enc setFragmentTexture:arrayView(src[e]) atIndex:0];
+        [enc setFragmentBytes:&sl length:sizeof sl atIndex:0];
+        [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+        [enc endEncoding];
+    }
+    [cb commit];
+    p_xrReleaseSwapchainImage(g_swap, NULL);
+
+    // at the pose the guest rendered with, so the runtime's reprojection makes up the rest
+    quat hq = {rp.qx, rp.qy, rp.qz, rp.qw};
+    XrVector3f hp = {rp.px, rp.py - g_floor, rp.pz};
+    for (int e = 0; e < 2; e++) {
+        XrVector3f o = qrot(hq, g_eyeOff[e]);
+        quat q = qmul(hq, g_eyeRot[e]);
+        pv[e] = (XrCompositionLayerProjectionView){XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW};
+        pv[e].pose.position = (XrVector3f){hp.x + o.x, hp.y + o.y, hp.z + o.z};
+        pv[e].pose.orientation = (XrQuaternionf){q.x, q.y, q.z, q.w};
+        pv[e].fov = (XrFovf){-atanf(rp.tangents[e][0]), atanf(rp.tangents[e][1]),
+                             atanf(rp.tangents[e][2]), -atanf(rp.tangents[e][3])};
+        pv[e].subImage.swapchain = g_swap;
+        pv[e].subImage.imageRect = (XrRect2Di){{0, 0}, {(int32_t)g_w, (int32_t)g_h}};
+        pv[e].subImage.imageArrayIndex = (uint32_t)e;
+    }
+    return 1;
+}
+
+
+// ---- controllers: OpenXR actions on the Touch profile, out through kl_ovrp's raw ovrp bits ----
+
+enum { A_GRIP, A_TRIGGER, A_SQUEEZE, A_STICK, A_STICK_CLICK, A_STICK_TOUCH, A_PRIMARY, A_SECONDARY,
+       A_PRIMARY_TOUCH, A_SECONDARY_TOUCH, A_TRIGGER_TOUCH, A_MENU, A_COUNT };
+static XrActionSet g_set;
+static XrAction g_act[A_COUNT];
+static XrPath g_handPath[2];
+static XrSpace g_gripSpace[2];
+
+static XrPath path(const char *s) {
+    static PFN_xrStringToPath toPath;
+    if (!toPath) toPath = (PFN_xrStringToPath)xrfn("xrStringToPath");
+    XrPath p = XR_NULL_PATH;
+    toPath(g_inst, s, &p);
+    return p;
+}
+
+static int initInput(void) {
+    XrActionSetCreateInfo si = {XR_TYPE_ACTION_SET_CREATE_INFO};
+    strcpy(si.actionSetName, "klepton");
+    strcpy(si.localizedActionSetName, "Klepton");
+    CHECK(((PFN_xrCreateActionSet)xrfn("xrCreateActionSet"))(g_inst, &si, &g_set));
+    g_handPath[0] = path("/user/hand/left");
+    g_handPath[1] = path("/user/hand/right");
+    static const struct { const char *name; XrActionType type; } defs[A_COUNT] = {
+        {"grip", XR_ACTION_TYPE_POSE_INPUT}, {"trigger", XR_ACTION_TYPE_FLOAT_INPUT},
+        {"squeeze", XR_ACTION_TYPE_FLOAT_INPUT}, {"stick", XR_ACTION_TYPE_VECTOR2F_INPUT},
+        {"stick_click", XR_ACTION_TYPE_BOOLEAN_INPUT}, {"stick_touch", XR_ACTION_TYPE_BOOLEAN_INPUT},
+        {"primary", XR_ACTION_TYPE_BOOLEAN_INPUT}, {"secondary", XR_ACTION_TYPE_BOOLEAN_INPUT},
+        {"primary_touch", XR_ACTION_TYPE_BOOLEAN_INPUT}, {"secondary_touch", XR_ACTION_TYPE_BOOLEAN_INPUT},
+        {"trigger_touch", XR_ACTION_TYPE_BOOLEAN_INPUT}, {"menu", XR_ACTION_TYPE_BOOLEAN_INPUT},
+    };
+    PFN_xrCreateAction create = (PFN_xrCreateAction)xrfn("xrCreateAction");
+    for (int i = 0; i < A_COUNT; i++) {
+        XrActionCreateInfo ai = {XR_TYPE_ACTION_CREATE_INFO};
+        strcpy(ai.actionName, defs[i].name);
+        strcpy(ai.localizedActionName, defs[i].name);
+        ai.actionType = defs[i].type;
+        ai.countSubactionPaths = 2;
+        ai.subactionPaths = g_handPath;
+        CHECK(create(g_set, &ai, &g_act[i]));
+    }
+    static const struct { int act; const char *path; } bind[] = {
+        {A_GRIP, "/user/hand/left/input/grip/pose"}, {A_GRIP, "/user/hand/right/input/grip/pose"},
+        {A_TRIGGER, "/user/hand/left/input/trigger/value"}, {A_TRIGGER, "/user/hand/right/input/trigger/value"},
+        {A_SQUEEZE, "/user/hand/left/input/squeeze/value"}, {A_SQUEEZE, "/user/hand/right/input/squeeze/value"},
+        {A_STICK, "/user/hand/left/input/thumbstick"}, {A_STICK, "/user/hand/right/input/thumbstick"},
+        {A_STICK_CLICK, "/user/hand/left/input/thumbstick/click"}, {A_STICK_CLICK, "/user/hand/right/input/thumbstick/click"},
+        {A_STICK_TOUCH, "/user/hand/left/input/thumbstick/touch"}, {A_STICK_TOUCH, "/user/hand/right/input/thumbstick/touch"},
+        {A_PRIMARY, "/user/hand/left/input/x/click"}, {A_PRIMARY, "/user/hand/right/input/a/click"},
+        {A_SECONDARY, "/user/hand/left/input/y/click"}, {A_SECONDARY, "/user/hand/right/input/b/click"},
+        {A_PRIMARY_TOUCH, "/user/hand/left/input/x/touch"}, {A_PRIMARY_TOUCH, "/user/hand/right/input/a/touch"},
+        {A_SECONDARY_TOUCH, "/user/hand/left/input/y/touch"}, {A_SECONDARY_TOUCH, "/user/hand/right/input/b/touch"},
+        {A_TRIGGER_TOUCH, "/user/hand/left/input/trigger/touch"}, {A_TRIGGER_TOUCH, "/user/hand/right/input/trigger/touch"},
+        {A_MENU, "/user/hand/left/input/menu/click"},
+    };
+    enum { NB = sizeof bind / sizeof bind[0] };
+    XrActionSuggestedBinding sb[NB];
+    for (int i = 0; i < NB; i++) sb[i] = (XrActionSuggestedBinding){g_act[bind[i].act], path(bind[i].path)};
+    XrInteractionProfileSuggestedBinding ps = {XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+    ps.interactionProfile = path("/interaction_profiles/oculus/touch_controller");
+    ps.countSuggestedBindings = NB;
+    ps.suggestedBindings = sb;
+    CHECK(((PFN_xrSuggestInteractionProfileBindings)xrfn("xrSuggestInteractionProfileBindings"))(g_inst, &ps));
+    XrSessionActionSetsAttachInfo at = {XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO};
+    at.countActionSets = 1;
+    at.actionSets = &g_set;
+    CHECK(((PFN_xrAttachSessionActionSets)xrfn("xrAttachSessionActionSets"))(g_sess, &at));
+    for (int h = 0; h < 2; h++) {
+        XrActionSpaceCreateInfo asi = {XR_TYPE_ACTION_SPACE_CREATE_INFO};
+        asi.action = g_act[A_GRIP];
+        asi.subactionPath = g_handPath[h];
+        asi.poseInActionSpace.orientation.w = 1;
+        CHECK(((PFN_xrCreateActionSpace)xrfn("xrCreateActionSpace"))(g_sess, &asi, &g_gripSpace[h]));
+    }
+    return 1;
+}
+
+static int boolState(int act, int h) {
+    static PFN_xrGetActionStateBoolean get;
+    if (!get) get = (PFN_xrGetActionStateBoolean)xrfn("xrGetActionStateBoolean");
+    XrActionStateGetInfo gi = {XR_TYPE_ACTION_STATE_GET_INFO, NULL, g_act[act], g_handPath[h]};
+    XrActionStateBoolean st = {XR_TYPE_ACTION_STATE_BOOLEAN};
+    return XR_SUCCEEDED(get(g_sess, &gi, &st)) && st.isActive && st.currentState;
+}
+
+static float floatState(int act, int h) {
+    static PFN_xrGetActionStateFloat get;
+    if (!get) get = (PFN_xrGetActionStateFloat)xrfn("xrGetActionStateFloat");
+    XrActionStateGetInfo gi = {XR_TYPE_ACTION_STATE_GET_INFO, NULL, g_act[act], g_handPath[h]};
+    XrActionStateFloat st = {XR_TYPE_ACTION_STATE_FLOAT};
+    return XR_SUCCEEDED(get(g_sess, &gi, &st)) && st.isActive ? st.currentState : 0.0f;
+}
+
+static XrVector2f stickState(int h) {
+    static PFN_xrGetActionStateVector2f get;
+    if (!get) get = (PFN_xrGetActionStateVector2f)xrfn("xrGetActionStateVector2f");
+    XrActionStateGetInfo gi = {XR_TYPE_ACTION_STATE_GET_INFO, NULL, g_act[A_STICK], g_handPath[h]};
+    XrActionStateVector2f st = {XR_TYPE_ACTION_STATE_VECTOR2F};
+    return XR_SUCCEEDED(get(g_sess, &gi, &st)) && st.isActive ? st.currentState : (XrVector2f){0, 0};
+}
+
+static void publishControllers(XrTime t) {
+    if (!g_input) return;
+    static PFN_xrSyncActions sync;
+    if (!sync) sync = (PFN_xrSyncActions)xrfn("xrSyncActions");
+    XrActiveActionSet aas = {g_set, XR_NULL_PATH};
+    XrActionsSyncInfo syi = {XR_TYPE_ACTIONS_SYNC_INFO, NULL, 1, &aas};
+    if (XR_FAILED(sync(g_sess, &syi))) return;
+    for (int h = 0; h < 2; h++) {
+        XrSpaceLocation l = {XR_TYPE_SPACE_LOCATION};
+        if (XR_SUCCEEDED(p_xrLocateSpace(g_gripSpace[h], g_local, t, &l)) &&
+            (l.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT))
+            kl_ovrp_set_hand_pose(h, l.pose.position.x, l.pose.position.y + g_floor, l.pose.position.z,
+                                  l.pose.orientation.x, l.pose.orientation.y, l.pose.orientation.z,
+                                  l.pose.orientation.w);
+        // A/B are the right hand's face buttons and X/Y the left's, each in its own hand's word
+        uint32_t b = 0, touch = 0;
+        float trig = floatState(A_TRIGGER, h), grip = floatState(A_SQUEEZE, h);
+        XrVector2f st = stickState(h);
+        if (boolState(A_PRIMARY, h)) b |= h ? KL_OVRP_RAW_A : KL_OVRP_RAW_X;
+        if (boolState(A_SECONDARY, h)) b |= h ? KL_OVRP_RAW_B : KL_OVRP_RAW_Y;
+        if (boolState(A_STICK_CLICK, h)) b |= h ? KL_OVRP_RAW_RTHUMBSTICK : KL_OVRP_RAW_LTHUMBSTICK;
+        if (h == 0 && boolState(A_MENU, h)) b |= KL_OVRP_RAW_START;
+        if (trig > 0.5f) b |= h ? KL_OVRP_RAW_RINDEX_TRIGGER : KL_OVRP_RAW_LINDEX_TRIGGER;
+        if (grip > 0.5f) b |= h ? KL_OVRP_RAW_RHAND_TRIGGER : KL_OVRP_RAW_LHAND_TRIGGER;
+        if (h == 1) {
+            if (st.y > 0.5f) b |= KL_OVRP_RAW_RTHUMBSTICK_UP;
+            if (st.y < -0.5f) b |= KL_OVRP_RAW_RTHUMBSTICK_DOWN;
+            if (st.x < -0.5f) b |= KL_OVRP_RAW_RTHUMBSTICK_LEFT;
+            if (st.x > 0.5f) b |= KL_OVRP_RAW_RTHUMBSTICK_RIGHT;
+        }
+        // ovrpTouch: same bits as the buttons for the face buttons and sticks, plus the triggers
+        if (boolState(A_PRIMARY_TOUCH, h)) touch |= h ? KL_OVRP_RAW_A : KL_OVRP_RAW_X;
+        if (boolState(A_SECONDARY_TOUCH, h)) touch |= h ? KL_OVRP_RAW_B : KL_OVRP_RAW_Y;
+        if (boolState(A_STICK_TOUCH, h)) touch |= h ? KL_OVRP_RAW_RTHUMBSTICK : KL_OVRP_RAW_LTHUMBSTICK;
+        if (boolState(A_TRIGGER_TOUCH, h) || trig > 0.05f) touch |= h ? 0x10 : 0x1000;
+        kl_ovrp_set_controller_input(h, b, touch | b, trig, grip, st.x, st.y);
+    }
+}
+
+static double nowS(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+
+int kl_mvr_main(volatile int *quit) {
+    const char *fe = getenv("KL_FRAMES");
+    long limit = fe ? atol(fe) : 0;
+    int running = 0;
+    long frames = 0, shown = 0;
+    uint64_t lastValue = 0;
+    double t0 = nowS();
+    long frames0 = 0, shown0 = 0;
+    while (!*quit && (!limit || frames < limit)) {
+        XrEventDataBuffer ev = {XR_TYPE_EVENT_DATA_BUFFER};
+        while (p_xrPollEvent(g_inst, &ev) == XR_SUCCESS) {
+            if (ev.type == XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED) {
+                XrSessionState s = ((XrEventDataSessionStateChanged *)&ev)->state;
+                if (s == XR_SESSION_STATE_READY && !running) {
+                    XrSessionBeginInfo bi = {XR_TYPE_SESSION_BEGIN_INFO};
+                    bi.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+                    running = XR_SUCCEEDED(p_xrBeginSession(g_sess, &bi));
+                } else if (s == XR_SESSION_STATE_STOPPING && running) {
+                    p_xrEndSession(g_sess);
+                    running = 0;
+                } else if (s == XR_SESSION_STATE_EXITING || s == XR_SESSION_STATE_LOSS_PENDING) {
+                    *quit = 1;
+                }
+            }
+            ev = (XrEventDataBuffer){XR_TYPE_EVENT_DATA_BUFFER};
+        }
+        if (!running) { usleep(10000); continue; }
+
+        XrFrameState fs = {XR_TYPE_FRAME_STATE};
+        if (XR_FAILED(p_xrWaitFrame(g_sess, NULL, &fs))) break;
+        publishPoses(fs.predictedDisplayTime);
+        publishControllers(fs.predictedDisplayTime);
+        dispatch_semaphore_signal(g_pace);
+        p_xrBeginFrame(g_sess, NULL);
+
+        XrCompositionLayerProjectionView pv[2];
+        XrCompositionLayerProjection pl = {XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+        const XrCompositionLayerBaseHeader *layers[1] = {(const XrCompositionLayerBaseHeader *)&pl};
+        XrFrameEndInfo ei = {XR_TYPE_FRAME_END_INFO};
+        ei.displayTime = fs.predictedDisplayTime;
+        ei.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+        if (fs.shouldRender && drawGuestFrame(pv, &lastValue)) {
+            pl.space = g_local;
+            pl.viewCount = 2;
+            pl.views = pv;
+            ei.layerCount = 1;
+            ei.layers = layers;
+            shown++;
+        }
+        p_xrEndFrame(g_sess, &ei);
+        frames++;
+
+        double t = nowS();
+        if (t - t0 >= 1.0) {
+            uint64_t serial = kl_vulkan_frame_serial();
+            fprintf(stderr, "  [mvr] display %.1f fps, new guest frames %.1f/s%s\n",
+                    (frames - frames0) / (t - t0), (shown - shown0) / (t - t0),
+                    serial ? "" : " (GL guest)");
+            t0 = t; frames0 = frames; shown0 = shown;
+        }
+    }
+    if (running) p_xrEndSession(g_sess);
+    fprintf(stderr, "  [mvr] %ld display frames, %ld with a new guest frame\n", frames, shown);
+    return 0;
+}
