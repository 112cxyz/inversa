     mtx_log("init", m, (uint32_t)(e - g_mtx_map));
     return 0;
 }
+// After fork(), in the child. Darwin gives the child's thread a new thread id, so the host
+// mutexes it held as the parent's thread no longer count as its own and can't be unlocked, and
+// those other threads held don't have a holder left at all. Rebuild every held one: the
+// forking thread's (same pthread_self in the child) re-taken to the same depth, the rest free.
+// The old host mutexes leak: a held mutex can't be destroyed.
+static void mtx_rebuild_after_fork(mtx_entry *e, void *self) {
+    if (!atomic_load(&e->key) || !atomic_load(&e->owner)) return;
+    pthread_mutex_t *fresh = mtx_make();
+    if (!fresh) return;
+    if (atomic_load(&e->owner) == self) {
+        for (int d = atomic_load(&e->depth); d > 0; d--) pthread_mutex_lock(fresh);
+    } else {
+        atomic_store(&e->owner, NULL);
+        atomic_store(&e->locksite, NULL);
+        atomic_store(&e->depth, 0);
+    }
+    atomic_store(&e->m, fresh);
+}
+
+void kl_pthread_atfork_child(void) {
+    void *self = (void *)pthread_self();
+    for (unsigned i = 0; i < MTX_MAP_SIZE; i++) mtx_rebuild_after_fork(&g_mtx_map[i], self);
+    mtx_rebuild_after_fork(&g_mtx_overflow, self);
+}
