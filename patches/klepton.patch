+static void and_bools(VkBool32 *want, const VkBool32 *have, size_t n, const char *what) {
+    for (size_t i = 0; i < n; i++)
+        if (want[i] && !have[i]) {
+            VKI("device feature %s[%zu] not supported by MoltenVK, cleared\n", what, i);
