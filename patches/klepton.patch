+static void clamp_device_features(VkPhysicalDevice phys, const VkDeviceCreateInfo *ci) {
+    PFN_vkGetPhysicalDeviceFeatures2 gpf2 =
+        (PFN_vkGetPhysicalDeviceFeatures2)real_gipa(g_instance, "vkGetPhysicalDeviceFeatures2");
+    PFN_vkGetPhysicalDeviceFeatures gpf =
+        (PFN_vkGetPhysicalDeviceFeatures)real_gipa(g_instance, "vkGetPhysicalDeviceFeatures");
+    if (ci->pEnabledFeatures && gpf) {
+        VkPhysicalDeviceFeatures have;
+        gpf(phys, &have);
+        and_bools((VkBool32 *)ci->pEnabledFeatures, (const VkBool32 *)&have,
+                  sizeof have / sizeof(VkBool32), "core");
+    }
+    if (!gpf2) return;
+    for (VkBaseOutStructure *p = (VkBaseOutStructure *)ci->pNext; p; p = p->pNext) {
+        size_t sz = feature_struct_size(p->sType);
+        if (!sz) continue;
+        uint8_t scratch[512] __attribute__((aligned(16)));
+        if (sz > sizeof scratch) continue;
+        memset(scratch, 0, sizeof scratch);
+        ((VkBaseOutStructure *)scratch)->sType = p->sType;
+        if (p->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2) {
+            gpf2(phys, (VkPhysicalDeviceFeatures2 *)scratch);
+        } else {
+            VkPhysicalDeviceFeatures2 f2 = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = scratch };
+            gpf2(phys, &f2);
+        }
+        char what[32];
+        snprintf(what, sizeof what, "sType %d", (int)p->sType);
+        and_bools((VkBool32 *)((uint8_t *)p + 16), (const VkBool32 *)(scratch + 16), (sz - 16) / sizeof(VkBool32), what);
+    }
+}
