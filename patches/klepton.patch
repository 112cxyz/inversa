+// A destroyed device must leave the table: the Cmd* wrappers and capture paths
+// all take g_devs[0], and engines often create and drop a probe device first.
+// The record itself is kept (never freed) since a racing thread may hold it.
+static void VKAPI_CALL klvk_DestroyDevice(VkDevice dev, const void *alloc) {
+    void (*real)(VkDevice, const void *) = real_gdpa ?
+        (void (*)(VkDevice, const void *))real_gdpa(dev, "vkDestroyDevice") : NULL;
+    pthread_mutex_lock(&g_lock);
+    for (int i = 0; i < g_ndev; i++)
+        if (g_devs[i]->dev == dev) {
+            memmove(&g_devs[i], &g_devs[i + 1], (g_ndev - i - 1) * sizeof *g_devs);
+            g_ndev--;
+            break;
+        }
+    pthread_mutex_unlock(&g_lock);
+    VKI("vkDestroyDevice %p, %d device(s) left\n", (void *)dev, g_ndev);
+    if (real) real(dev, alloc);
+}
