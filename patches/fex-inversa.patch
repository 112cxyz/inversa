+#ifdef FEX_INVERSA
+// macOS has no /proc, so the links on the way to /proc/self/exe are answered here, for programs
+// that resolve it one component at a time (Unity): /proc/self links to the pid, and /proc and
+// /proc/<pid> are directories. thread-self goes to the process too, whose exe is the same.
+static std::optional<uint64_t> InversaProcLink(const char* Path, char* Buf, size_t Size, int PID) {
+  char Dir[32];
+  snprintf(Dir, sizeof(Dir), "/proc/%i", PID);
+  if (strcmp(Path, "/proc/self") == 0 || strcmp(Path, "/proc/thread-self") == 0) {
+    char Pid[16];
+    const size_t Len = std::min<size_t>(Size, snprintf(Pid, sizeof(Pid), "%i", PID));
+    memcpy(Buf, Pid, Len);
+    return Len;
+  }
+  if (strcmp(Path, "/proc") == 0 || strcmp(Path, Dir) == 0) {
+    errno = EINVAL;
+    return -1;
+  }
+  return std::nullopt;
+}
+#endif
