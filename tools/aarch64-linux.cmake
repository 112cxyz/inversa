# Cross-compile guest code (FEX) for glibc ARM64 Linux from macOS with LLVM's clang + lld
# against the Debian sysroot from tools/make_sysroot.py.
#   INVERSA_LLVM     clang's bin dir (default: Homebrew llvm)
#   INVERSA_SYSROOT  the sysroot (default: build/sysroot)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(TC "$ENV{INVERSA_LLVM}")
if(NOT TC)
  set(TC "/opt/homebrew/opt/llvm/bin")
endif()
set(CMAKE_SYSROOT "$ENV{INVERSA_SYSROOT}")
if(NOT CMAKE_SYSROOT)
  set(CMAKE_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/../build/sysroot")
endif()
find_program(LLD ld.lld PATHS /opt/homebrew/opt/lld/bin "${TC}" NO_DEFAULT_PATH)
set(CMAKE_C_COMPILER "${TC}/clang")
set(CMAKE_CXX_COMPILER "${TC}/clang++")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_AR "${TC}/llvm-ar")
set(CMAKE_RANLIB "${TC}/llvm-ranlib")
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr -fPIC")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${CMAKE_SYSROOT}/usr -fPIC -stdlib=libstdc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=${LLD} --gcc-toolchain=${CMAKE_SYSROOT}/usr")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=${LLD} --gcc-toolchain=${CMAKE_SYSROOT}/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
