<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.application-identifier</key><string>DXQ46W3K28.dev.moltenvr.xarch-probe</string>
<key>com.apple.developer.team-identifier</key><string>DXQ46W3K28</string>
<key>com.apple.developer.cross-architecture-support</key><true/>
<!-- hardened runtime (needed for notarization): FEX maps its code buffers MAP_JIT, Klepton
     loads and patches Linux code in writable memory, and Vulkan comes from Homebrew dylibs -->
